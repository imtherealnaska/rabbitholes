---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<aside class="tip">
  <div class="tip-label">
    <span class="tip-icon">◐</span>
    <span>—— {title} ——</span>
  </div>
  <div class="tip-body">
    <slot />
  </div>
</aside>

<style>
  .tip {
    margin: 26px 0;
    padding: 16px 18px 14px;
    border: 1px solid rgb(var(--rule));
    border-left: 3px solid rgb(var(--fg));
    background: rgba(0, 0, 0, 0.015);
  }

  :global(.dark) .tip {
    background: rgba(255, 255, 255, 0.02);
  }

  .tip-label {
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(var(--muted));
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tip-icon {
    font-size: 11px;
  }

  .tip-body {
    font-size: 13px;
    line-height: 1.6;
  }
</style>
