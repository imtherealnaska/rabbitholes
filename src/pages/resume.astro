---
import SeoPage from "@/components/SeoPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <SeoPage slot="head" title="Resume" />

  <div class="grid gap-8">
    <!-- Header -->
    <div>
      <h2 class="text-xl font-bold">Narendra S Kapashi</h2>
      <p class="mt-1 text-sm">
        Bengaluru, India &middot;
        <a href="mailto:skapashinarendra@gmail.com"
          >skapashinarendra@gmail.com</a
        > &middot;
        <a href="https://github.com/imtherealnaska">github.com/imtherealnaska</a
        > &middot;
        <a href="https://linkedin.com/in/narendra123"
          >linkedin.com/in/narendra123</a
        >
      </p>
    </div>

    <!-- Summary -->
    <section>
      <h3 class="mb-2 border-b pb-1 text-base font-semibold">Summary</h3>
      <p class="text-sm">
        Systems software engineer with 5+ years of production backend experience
        at HPE, specializing in protocol-level integration and systems-level
        reliability engineering. Here, building high-performance Rust
        applications focused on async networking, protocol implementation, and
        concurrent systems design.
      </p>
    </section>

    <!-- Skills -->
    <section>
      <h3 class="mb-3 border-b pb-1 text-base font-semibold">Skills</h3>
      <ul class="grid list-none gap-1.5 p-0 text-sm">
        {
          [
            {
              label: "Rust Ecosystem",
              items: "Rust, Tokio, Axum, Serde, async/await",
            },
            { label: "Languages", items: "Java, Python, Bash, SQL" },
            {
              label: "Systems & Infrastructure",
              items: "Linux (Rocky, Ubuntu), Docker, PostgreSQL, Redis, Samba",
            },
            { label: "Frontend", items: "React, Grommet" },
          ].map(({ label, items }) => (
            <li>
              <span class="font-medium">{label}:</span> {items}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Experience -->
    <section>
      <h3 class="mb-3 border-b pb-1 text-base font-semibold">Experience</h3>
      <div>
        <div class="flex flex-wrap items-baseline justify-between gap-1">
          <span class="font-medium">Hewlett Packard Enterprise (HPE)</span>
          <span class="text-sm">Bengaluru, India</span>
        </div>
        <div
          class="flex flex-wrap items-baseline justify-between gap-1 text-sm"
        >
          <span>
            System Software Engineer 2 &middot; System Software Engineer 1
          </span>
          <span>2021 – Present</span>
        </div>
        <ul class="mt-2 grid list-none gap-2 p-0 text-sm">
          {
            [
              {
                title: "SAMBA NAS Integration",
                body: "Architected protocol-level integration of SAMBA into the NAS manageability stack, replacing a 7-year-old Likewise protocol stack; designed an authentication system supporting local user and Active Directory-based auth, ensuring zero data loss during share migration and restoring interoperability with modern Windows environments.",
              },
              {
                title: "PostgreSQL 12 → 18 Migration",
                body: "Delivered zero-downtime data migration of PostgreSQL 12 → 18 across the full management stack via backwards-compatible schema evolution, extension upgrades, and multi-stage service validation; retired an end-of-life MongoDB config store in the same release, eliminating a critical security exposure vector.",
              },
              {
                title: "P0 Outage Resolution",
                body: "Diagnosed and resolved multiple P0 outages covering memory management failures (JVM heap exhaustion), OS-level networking regressions impacting 15+ enterprise customers, and a concurrency defect in the software update pipeline; performed systems-level root cause analysis through deep log and code path tracing with zero recurrence.",
              },
              {
                title: "Software Update Reliability",
                body: "Identified and resolved a flag-race concurrency defect where a stale Java process intermittently blocked customer upgrade workflows; applied systematic execution sequence reordering and introduced stale process detection guards to harden the pipeline against future concurrency failures.",
              },
              {
                title: "Support Console TUI",
                body: "Reduced diagnostic collection time by 40% by developing a Python 3.9 TUI that consolidated 60+ manual diagnostic commands into a unified automated workflow, eliminating missed steps during critical customer escalations.",
              },
              {
                title: "Frontend Cross-Domain Contribution",
                body: "Led Grommet 2.0 upgrade across the full product UI outside primary backend domain, delivering hardware image updates and new capability additions with no regressions to existing customer-facing workflows.",
              },
              {
                title: "Platform Bringup",
                body: "Contributed to a new platform generation launch as part of a 12-engineer team, bootstrapping 4 core backend services on Rocky Linux from scratch; shipped ERT log-collection scripts, configurable task timeouts, and established test coverage baselines across 7 backend repositories.",
              },
            ].map(({ title, body }) => (
              <li>
                <span class="font-medium">{title}:</span> {body}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Projects -->
    <section>
      <h3 class="mb-3 border-b pb-1 text-base font-semibold">Projects</h3>
      <ul class="grid list-none gap-3 p-0 text-sm">
        {
          [
            {
              title: "Consensus Board Game",
              body: "Single GameLoop actor owns all state via Tokio channels with WebSocket connections; thread safety enforced through Rust's type system with zero shared mutable state; concurrency correctness guaranteed at compile time by the borrow checker.",
              tags: "Rust — Tokio — WebSocket — Actor Pattern",
            },
            {
              title: "SourceMapper",
              body: "Rust code analysis tool using tree-sitter to parse source files into Abstract Syntax Trees (AST) and construct dependency and call graphs; leverages Rust's ownership model for zero-copy traversal; served via Axum REST API with Svelte frontend as a single binary.",
              tags: "Rust — Cargo — tree-sitter — Axum — Svelte",
            },
            {
              title: "SNMPv2 Manager",
              body: "Custom ASN.1 BER parser using Rust's pattern matching and type system; async/await architecture with Tokio for non-blocking UDP I/O; concurrency safety enforced by Rust's borrow checker across concurrent device polling.",
              tags: "Rust — Tokio — ASN.1 BER — UDP",
            },
            {
              title: "Redis-Compatible Server",
              body: "Full RESP protocol parser with pipelining and core command set on async Tokio runtime; Rust's ownership model eliminates data races across concurrent connections; benchmarked at ~85% of native Redis throughput.",
              tags: "Rust — Tokio — RESP",
            },
          ].map(({ title, body, tags }) => (
            <li>
              <span class="font-medium">{title}:</span> {body}{" "}
              <span class="italic">{tags}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Education -->
    <section>
      <h3 class="mb-3 border-b pb-1 text-base font-semibold">Education</h3>
      <div class="flex flex-wrap items-baseline justify-between gap-1 text-sm">
        <div>
          <p class="font-medium">The National Institute of Engineering</p>
          <p>Bachelor of Engineering in Information Science</p>
        </div>
        <div class="text-right">
          <p>Mysuru, India</p>
          <p>2016 – 2020</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
