---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SeoPage from "@/components/SeoPage.astro";
---

<BaseLayout>
  <SeoPage slot="head" title="About" />
  <div>
    <div style="text-align: center; color: rgb(var(--muted)); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 12px;">
      Colophon
    </div>
    <h1 style="font-size: 34px; font-weight: 700; text-align: center; margin: 0 0 30px; letter-spacing: -0.5px; line-height: 1.15;">
      About
    </h1>

    <div class="ornament">◆ who ◆</div>
    <p style="margin: 0 0 18px;">
      <span style="float: left; font-size: 64px; line-height: 0.85; font-weight: 700; padding-right: 10px; padding-top: 6px;">R</span>
      abbitholes is a writing project about the long way around getting something to compile.
      Mostly Rust. Sometimes Zig. Occasionally a 4,000-word aside on how a linker works.
    </p>
    <p style="margin: 0 0 18px; clear: left;">
      The author is a software engineer who keeps notes in public. The notes are not always
      finished. That is on purpose.
    </p>

    <div class="ornament">◆ setting ◆</div>
    <p style="margin: 0 0 18px;">
      This site is set in <em>Geist Mono</em> at 14px, on a paper-toned background of #f4f1ea.
      There are no trackers and no analytics. There is one RSS feed at
      <a href="/rss.xml" style="border-bottom: 1px solid currentColor;">/rss.xml</a>.
    </p>
  </div>
</BaseLayout>
