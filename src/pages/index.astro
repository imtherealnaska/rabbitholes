---
import { getCollection } from "astro:content";

import Post from "@/components/Post.astro";
import SeoPage from "@/components/SeoPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = (await getCollection("blog"))
  .sort(
    (a, b) =>
      b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf(),
  )
  .slice(0, 5);

const projects = await getCollection("projects");
---

<BaseLayout>
  <SeoPage slot="head" />
  <div>
    <div class="ornament">◆ recent posts ◆</div>
    <ul class="list-none p-0">
      {posts.map((post) => <Post post={post} />)}
    </ul>

    <div class="ornament">◆ projects ◆</div>
    {
      projects.map((project, i) => (
        <div style="padding: 18px 0; border-bottom: 1px dashed rgb(var(--rule));">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <span style="font-weight: 700; font-size: 16px;">
              № {String(i + 1).padStart(2, "0")} · {project.data.title}
            </span>
          </div>
          <div style="margin-bottom: 4px;">{project.data.description}</div>
          <a
            href={project.data.url}
            style="color: rgb(var(--muted)); font-size: 12px; border-bottom: 1px solid rgb(var(--muted));"
          >
            {project.data.url.replace(/^https?:\/\//, "")}
          </a>
        </div>
      ))
    }
  </div>
</BaseLayout>
