---
import "@/styles/global.css";
import "@/styles/reset.css";

import BaseHead from "@/components/BaseHead.astro";
import Navigation from "@/components/Navigation.astro";

const currentYear = new Date().getFullYear();
---

<html lang="en">
  <BaseHead>
    <slot name="head" />
  </BaseHead>
  <body class="font-mono">
    <Navigation />
    <main style="max-width: 760px; margin: 0 auto; padding: 0 32px 100px;">
      <slot />
    </main>
    <footer style="border-top: 1px solid rgb(var(--rule)); padding: 24px 32px; margin-top: 60px;">
      <div style="max-width: 760px; margin: 0 auto; display: flex; justify-content: space-between; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: rgb(var(--muted));">
        <span>© {currentYear} · rabbitholes</span>
        <span>—— set in mono ——</span>
        <span>
          <a href="/rss.xml">RSS</a> · <a href="https://github.com/imtherealnaska">github</a> · <a href="mailto:skapashinarendra@gmail.com">mail</a>
        </span>
      </div>
    </footer>
  </body>
</html>
